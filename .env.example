# Application
BASE_URL=http://localhost:8080
DEBUG=true
ADMIN_PATH=/admin
HTTPS=false

# Admin UI language — 'en' or 'cs' (station0 >= 0.5)
ADMIN_LOCALE=cs
# Block editor initial collapse state — remember | expanded | collapsed (station0 >= 0.7)
# ADMIN_BLOCK_COLLAPSE=remember

# Site path (optional — defaults to ./site)
# SITE_PATH=/absolute/path/to/site

# Mail (SMTP)
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME=Station0
MAIL_ENCRYPTION=tls

{% extends 'layout.twig' %}

{% block title %}{{ page.metatitle ?? page.title }} · {{ app.name }}{% endblock %}

{% block body %}
<article class="article">
    <p class="crumb"><a href="/blog">← Blog</a></p>
    <h1>{{ page.title }}</h1>
    {% if page.publishedAt %}
        <p class="article-meta">{{ page.publishedAt|date('j M Y') }}{% if page.author %} · {{ page.author }}{% endif %}
            {% include 'partials/category-badges.twig' %}</p>
    {% endif %}
    {% if fields.perex %}<p class="lead">{{ fields.perex }}</p>{% endif %}
    <div class="content">{{ content|raw }}</div>
</article>
{% endblock %}

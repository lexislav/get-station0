{#
  /blog/categories — every category of the blog-categories collection with
  its articles. Station0 caches whole pages and templates can't read the
  query string, so instead of /blog?category=x this one page lists all
  categories, and each category badge links to its #anchor here.
#}
{% extends 'layout.twig' %}

{% block title %}{{ page.metatitle ?? page.title }} · {{ app.name }}{% endblock %}

{% block body %}
{% set parent = page.urlPath|split('/')|slice(0, -1)|join('/') %}
{% set articles = child_pages(parent)|filter(a => a.template == 'article') %}
<article>
    <p class="crumb"><a href="{{ parent }}">← Blog</a></p>
    <h1>{{ page.title }}</h1>
    <div class="content">{{ content|raw }}</div>

    {% for cat in collection('blog-categories') %}
        <section class="category" id="{{ cat.slug }}">
            <h2><span class="badge" style="background: {{ cat.extra.color ?? '#eef2ff' }}">{{ cat.title }}</span></h2>
            {% if cat.extra.description %}<p class="muted">{{ cat.extra.description }}</p>{% endif %}
            <ul class="article-list">
                {% for a in articles|filter(a => cat.slug in page_fields(a).categories|default([])|map(r => r.category)) %}
                    <li><a href="{{ a.urlPath }}">{{ a.title }}</a>
                        {% if a.publishedAt %}<span class="muted"> — {{ a.publishedAt|date('j M Y') }}</span>{% endif %}</li>
                {% else %}
                    <li class="muted">No articles in this category yet.</li>
                {% endfor %}
            </ul>
        </section>
    {% endfor %}
</article>
{% endblock %}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app.name }}{% endblock %}</title>
    <link rel="stylesheet" href="/assets/site.css">
    {% block head %}{% endblock %}
</head>
<body>
{# ── Banners — the live items of the "banners" collection (/guide/collections) #}
{% set banners = collection('banners') %}
{% if banners %}
<div class="site-banners">
    {% for banner in banners %}
    <div class="site-banner" style="{% if banner.extra.color %}border-left-color:{{ banner.extra.color }};{% endif %}">
        <div class="site-banner-inner">
            <strong>{{ banner.title }}</strong>
            {% if banner.extra.subtitle %}
                <span class="site-banner-subtitle">{{ banner.extra.subtitle }}</span>
            {% endif %}
            {% if banner.extra.cta_url %}
                <a class="site-banner-cta" href="{{ banner.extra.cta_url }}"
                   {% if banner.extra.color %}style="color:{{ banner.extra.color }}"{% endif %}>
                    {{ banner.extra.cta_text ?? 'Learn more' }} →
                </a>
            {% endif %}
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

<header class="site-header">
    <a class="brand" href="/">{{ app.name }}</a>
    {# top_level_pages() = live first-level pages, minus nav-hidden / unlisted ones #}
    <nav class="site-nav">
        {% for p in top_level_pages() %}
            <a href="{{ p.urlPath }}"{% if page is defined and (page.urlPath == p.urlPath or page.urlPath starts with p.urlPath ~ '/') %} aria-current="page"{% endif %}>{{ p.title }}</a>
        {% endfor %}
    </nav>
    {# `visitor` = who is looking at the public site (/guide/members) #}
    <div class="site-visitor">
        {% if visitor.authenticated %}
            <span class="muted">{{ visitor.label }}</span>
            {% if visitor.staff %}<a href="{{ app.adminPath }}">Admin</a>{% endif %}
            {% if access.logoutPath ?? false %}
                <form method="post" action="{{ access.logoutPath }}">
                    <input type="hidden" name="{{ csrf.nameKey }}" value="{{ csrf.name }}">
                    <input type="hidden" name="{{ csrf.valueKey }}" value="{{ csrf.value }}">
                    <button type="submit" class="link">Sign out</button>
                </form>
            {% endif %}
        {% else %}
            {% if access.loginPath ?? false %}<a href="{{ access.loginPath }}">Sign in</a>{% endif %}
            <a href="{{ app.adminPath }}">Admin</a>
        {% endif %}
    </div>
</header>
<main class="container">
    {% block body %}{% endblock %}
</main>
<footer class="site-footer">
    <p>Built with Station0 · every page here explains the feature it uses — start at the <a href="/guide">Guide</a>.
       Rendered by <code>site/templates/{{ (page.template ?? 'layout') }}.twig</code>.</p>
</footer>
</body>
</html>
